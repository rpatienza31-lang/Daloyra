# Copy to .env.local for local development. Never commit real secrets.
# Vercel: add the same names under Project → Settings → Environment Variables.

# Public (safe in the browser). Supabase → Connect → Framework → Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET — server only. Supabase → Project Settings → API Keys → Secret keys.
# Bypasses Row Level Security. Used only by the Phase 8 admin area.
SUPABASE_SECRET_KEY=
